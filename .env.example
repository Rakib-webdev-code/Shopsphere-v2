# Copy this file to .env and fill in the values. Never commit .env.

# --- Required -------------------------------------------------------------
# Long random string. Generate one with: npx @better-auth/cli secret
BETTER_AUTH_SECRET=
# MongoDB connection string (Atlas or local)
MONGODB_URI=
# Public URL of the app. Used by auth links and Stripe redirects.
BETTER_AUTH_URL=http://localhost:3000
MONGODB_DB=shopsphere

# --- Social sign-in (optional) -------------------------------------------
# A provider is switched on only when both of its values are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Stripe card payments (optional) -------------------------------------
# Without STRIPE_SECRET_KEY checkout falls back to "pay later" orders.
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:3000/api/stripe/webhook`
STRIPE_WEBHOOK_SECRET=
# Only needed when it differs from BETTER_AUTH_URL
APP_URL=

# --- Email (optional) -----------------------------------------------------
# With RESEND_API_KEY, verification and password-reset emails are really sent.
# Without it they are printed in the server console during development.
RESEND_API_KEY=
EMAIL_FROM=

# --- Shopping assistant AI ranking (optional) ----------------------------
# Without these the assistant runs in deterministic catalog-only mode.
AI_ASSISTANT_API_KEY=
AI_ASSISTANT_MODEL=
AI_ASSISTANT_BASE_URL=
